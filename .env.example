# --- OpenWeatherMap ---
# Получить бесплатный ключ: https://openweathermap.org/api (тариф без карты)
OWM_API_KEY=your_api_key_here
OWM_UNITS=metric
OWM_LANG=ru

# --- Геолокация ---
# Используется как fallback, если ipinfo.io / ip-api.com / freeipapi.com недоступны
GEO_API_FALLBACK_CITY=Moscow
GEO_API_FALLBACK_LAT=55.7558
GEO_API_FALLBACK_LON=37.6176

# --- База данных ---
DB_PATH=./data/weather.db
# Альтернатива: полный DSN (например для другой СУБД)
# DATABASE_URL=sqlite:///./data/weather.db

# --- Выгрузка в Markdown ---
MD_OUTPUT_PATH=./output/forecast.md

# --- Сколько дней агрегировать: today + (N-1) ---
FORECAST_DAYS=4
