# --- OpenWeatherMap ---
# Получить бесплатный ключ: https://openweathermap.org/api (тариф без карты)
OWM_API_KEY=your_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/forecast
OWM_UNITS=metric
OWM_LANG=ru

# --- Геолокация ---
# Используется как fallback, если ipinfo.io / ip-api.com / freeipapi.com недоступны
GEO_API_URL=https://ipapi.co/json/
GEO_API_FALLBACK_CITY=Moscow

# --- База данных ---
DB_URL=sqlite:///./data/weather.db
DB_USER=USER
DB_PASSWORD=PASSWORD

# --- Прочее ---
ENVIRONMENT=development
OUTPUT_FILE=./output/forecast.md
FORECAST_DAYS=4

